# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- App ---
ENVIRONMENT=development

# --- Database ---
POSTGRES_USER=oblitrack
POSTGRES_PASSWORD=change-me
POSTGRES_DB=oblitrack
DATABASE_URL=postgresql+asyncpg://oblitrack:change-me@localhost:5432/oblitrack

# --- Auth ---
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Document storage ---
# Local filesystem path (outside any web-served root) where uploaded
# contract files are stored, keyed by server-generated org/contract UUIDs.
STORAGE_ROOT=storage

# --- Local embeddings ---
# BAAI/bge-base-en-v1.5 produces 768-dim vectors, matching the pgvector
# columns fixed in the Phase 1 migration — changing this needs a migration.
EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5

# --- LLM providers ---
# Groq (primary) — https://console.groq.com
GROQ_API_KEY=
# Google Gemini (fallback) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Daily quota ceilings used to pick a provider with headroom left before
# calling it (rather than trying-and-catching 429s) — see
# app/services/llm/quota.py. Defaults are conservative free-tier estimates;
# override once you know your account's actual observed limits.
# GROQ_DAILY_REQUEST_LIMIT=1000
# GROQ_DAILY_TOKEN_LIMIT=200000
# GEMINI_DAILY_REQUEST_LIMIT=250
# GEMINI_DAILY_TOKEN_LIMIT=1000000

# --- SMTP (alert emails) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
# UTC time the worker's daily status-recompute + alert-scan job runs.
# ALERT_SCAN_HOUR_UTC=7
# ALERT_SCAN_MINUTE_UTC=0

# How often (minutes) the worker retries extraction jobs left QUEUED
# because no LLM provider had quota headroom at upload time.
# EXTRACTION_RETRY_INTERVAL_MINUTES=30

# --- Chatbot (docs/CHATBOT_INTEGRATION_PLAN.md) ---
# Local cross-encoder reranker (CPU-only, no API cost).
# RERANKER_MODEL_NAME=BAAI/bge-reranker-base
# Guardrail/retrieval thresholds — see app/core/config.py for what each
# one gates.
# CHAT_SCOPE_CLASSIFIER_THRESHOLD=0.5
# CHAT_MIN_RELEVANCE_THRESHOLD=0.3
# CHAT_FAITHFULNESS_OVERLAP_THRESHOLD=0.6
# CHAT_MAX_HISTORY_MESSAGES=10
# CHAT_MAX_CONTEXT_CHUNKS=8
# CHAT_RATE_LIMIT=20/minute

# --- Observability: self-hosted Langfuse (optional) ---
# All three unset means chat tracing is a no-op — the chatbot works
# identically with or without this. Never point LANGFUSE_HOST at a
# cloud/SaaS instance. Start the local stack from infra/ (its own .env
# handling differs from the rest of this file — see
# docker-compose.langfuse.yml's header comment for the --env-file detail):
#   docker compose -f docker-compose.yml -f docker-compose.langfuse.yml up -d
# LANGFUSE_INIT_* below auto-provisions a ready-to-use project on first
# boot, so LANGFUSE_PUBLIC_KEY/LANGFUSE_SECRET_KEY here can just be
# whatever you set LANGFUSE_INIT_PROJECT_PUBLIC_KEY/_SECRET_KEY to below
# (they must match) — no manual sign-up-in-the-UI step required.
# LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-oblitrack-local
# LANGFUSE_SECRET_KEY=sk-lf-oblitrack-local-change-me
#
# Everything below is used only by docker-compose.langfuse.yml, never
# read by the backend itself — change all of it before running anywhere
# beyond a local machine only you can reach.
# LANGFUSE_POSTGRES_PASSWORD=change-me
# LANGFUSE_CLICKHOUSE_PASSWORD=change-me
# LANGFUSE_MINIO_ROOT_PASSWORD=change-me-too
# LANGFUSE_REDIS_AUTH=change-me-as-well
# LANGFUSE_SALT=change-me-to-a-long-random-value
# LANGFUSE_ENCRYPTION_KEY=change-me-to-a-64-char-hex-string
# LANGFUSE_NEXTAUTH_SECRET=change-me-to-a-long-random-value
# LANGFUSE_NEXTAUTH_URL=http://localhost:3000
# LANGFUSE_INIT_USER_EMAIL=admin@oblitrack.local
# LANGFUSE_INIT_USER_NAME=ObliTrack Admin
# LANGFUSE_INIT_USER_PASSWORD=change-me-to-a-real-password

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
